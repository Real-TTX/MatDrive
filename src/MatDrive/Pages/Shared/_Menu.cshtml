@model (MenuModel Menu, string Area)
@inject CurrentUser Me
@*
    The menus (SHELL-01 .. SHELL-19): one panel per menu of the switcher at the foot (SHELL-15), the one of the page shown.
    - drive:    New (a menu), My Drive, the shared drives, shared with me, recent, starred, trash, the storage locations, the space used
    - settings: profile, password, app passwords (WebDAV), my data
    - admin:    users, storage locations, integrations, activity, system (administrators only)
    A page names what it shows: ViewData["NavKey"] ("my", "shared", "recent", "starred", "trash", "drive-12", "location-3").
*@
@{
    var m = Model.Menu;
    var path = Context.Request.Path.Value ?? "/";
    var key = ViewData["NavKey"] as string;

    bool Under(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase) || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    string Cls(bool active) => "mat-nav__item" + (active ? " is-active" : string.Empty);
    string Cur(bool active) => active ? "page" : null!;
    string Badge(int n) => n > 99 ? "99+" : n.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<nav class="mat-nav__scroll" aria-label="@L["Shell.Area.Drive"]" data-nav-panel="drive" hidden="@(Model.Area != "drive")">
    <ul class="mat-nav__list">
        <li>
            <button type="button" class="mat-nav__item mat-nav__item--primary" data-menu-toggle="new-menu" aria-haspopup="menu" aria-expanded="false" data-new-button>@Ui.Icon("plus")<span>@L["Drive.New"]</span></button>
        </li>
        <li><a class="@Cls(key == "my")" href="/drive" aria-current="@Cur(key == "my")">@Ui.Icon("hard-drive")<span>@L["Drive.My"]</span></a></li>
        <li><a class="@Cls(key == "shared")" href="/drive/shared" aria-current="@Cur(key == "shared")">@Ui.Icon("users")<span>@L["Drive.SharedWithMe"]</span></a></li>
        <li><a class="@Cls(key == "recent")" href="/drive/recent" aria-current="@Cur(key == "recent")">@Ui.Icon("clock")<span>@L["Drive.Recent"]</span></a></li>
        <li><a class="@Cls(key == "starred")" href="/drive/starred" aria-current="@Cur(key == "starred")">@Ui.Icon("star")<span>@L["Drive.Starred"]</span></a></li>
        <li><a class="@Cls(key == "trash")" href="/drive/trash" aria-current="@Cur(key == "trash")">@Ui.Icon("trash")<span>@L["Drive.Trash"]</span>@if (m.Trash > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(m.Trash)</span> }</a></li>

        <li class="mat-nav__group mat-nav__group--action" role="presentation">
            <span class="mat-nav__group-title">@L["Drive.SharedDrives"]</span>
            <a class="mat-nav__group-action" href="/drives" aria-label="@L["Drives.Manage"]" aria-current="@Cur(Under("/drives"))">@Ui.Icon("settings")</a>
        </li>
        @if (m.SharedDrives.Count == 0)
        {
            <li><a class="@Cls(Under("/drives"))" href="/drives/edit">@Ui.Icon("plus")<span>@L["Drives.New"]</span></a></li>
        }
        @foreach (var d in m.SharedDrives)
        {
            var on = key == "drive-" + d.Id;
            <li><a class="@Cls(on)" href="/drive/shared-drive/@d.Id" aria-current="@Cur(on)"><svg class="mat-icon" data-colour="@d.Colour" aria-hidden="true" focusable="false"><use href="#mat-i-shared-drive"></use></svg><span>@d.Name</span></a></li>
        }

        @if (m.Locations.Count > 0)
        {
            <li class="mat-nav__group" role="presentation">@L["Locations.Title"]</li>
            @foreach (var l in m.Locations)
            {
                var on = key == "location-" + l.Id;
                <li><a class="@Cls(on)" href="/locations/@l.Id" aria-current="@Cur(on)">@Ui.Icon(l.Kind == LocationKind.Local ? "server" : "network")<span>@l.Name</span></a></li>
            }
        }
    </ul>

    @* the space of My Drive *@
    <div class="md-usage">
        @if (m.Usage.Quota is { } quota)
        {
            <div class="mat-meter" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(Math.Round(m.Usage.Share * 100))" aria-label="@L["Drive.Storage"]"><span class="mat-meter__fill" data-value="@(Math.Round(m.Usage.Share * 100))" data-tone="@(m.Usage.Share > 0.9 ? "error" : m.Usage.Share > 0.75 ? "warn" : null)"></span></div>
            <a class="md-usage__text" href="/drive/storage">@L["Drive.UsedOf", Ui.Bytes(m.Usage.Used), Ui.Bytes(quota)]</a>
        }
        else
        {
            <a class="md-usage__text" href="/drive/storage">@L["Drive.Used", Ui.Bytes(m.Usage.Used)]</a>
        }
    </div>
</nav>

<nav class="mat-nav__scroll" aria-label="@L["Settings.Title"]" data-nav-panel="settings" hidden="@(Model.Area != "settings")">
    <ul class="mat-nav__list">
        <li><a class="@Cls(path.Equals("/Account", StringComparison.OrdinalIgnoreCase))" href="/Account" aria-current="@Cur(path.Equals("/Account", StringComparison.OrdinalIgnoreCase))">@Ui.Icon("user")<span>@L["Settings.Profile"]</span></a></li>
        <li><a class="@Cls(Under("/Account/Password"))" href="/Account/Password" aria-current="@Cur(Under("/Account/Password"))">@Ui.Icon("lock")<span>@L["Password.Title"]</span></a></li>
        <li><a class="@Cls(Under("/Account/AppPasswords"))" href="/Account/AppPasswords" aria-current="@Cur(Under("/Account/AppPasswords"))">@Ui.Icon("key")<span>@L["AppPasswords.Title"]</span></a></li>
        <li><a class="@Cls(Under("/Account/Data"))" href="/Account/Data" aria-current="@Cur(Under("/Account/Data"))">@Ui.Icon("database")<span>@L["Data.Title"]</span></a></li>
    </ul>
</nav>

@if (Me.IsAdmin)
{
    <nav class="mat-nav__scroll" aria-label="@L["Admin.Title"]" data-nav-panel="admin" hidden="@(Model.Area != "admin")">
        <ul class="mat-nav__list">
            <li><a class="@Cls(Under("/Admin/Users"))" href="/Admin/Users" aria-current="@Cur(Under("/Admin/Users"))">@Ui.Icon("user-circle")<span>@L["Users.Title"]</span></a></li>
            <li><a class="@Cls(Under("/Admin/Locations"))" href="/Admin/Locations" aria-current="@Cur(Under("/Admin/Locations"))">@Ui.Icon("server")<span>@L["Locations.Title"]</span></a></li>
            <li><a class="@Cls(Under("/Admin/Integrations"))" href="/Admin/Integrations" aria-current="@Cur(Under("/Admin/Integrations"))">@Ui.Icon("plug")<span>@L["Integrations.Title"]</span></a></li>
            <li><a class="@Cls(Under("/Admin/Activity"))" href="/Admin/Activity" aria-current="@Cur(Under("/Admin/Activity"))">@Ui.Icon("activity")<span>@L["Activity.Title"]</span></a></li>
            <li><a class="@Cls(Under("/Admin/System"))" href="/Admin/System" aria-current="@Cur(Under("/Admin/System"))">@Ui.Icon("settings")<span>@L["System.Title"]</span></a></li>
        </ul>
    </nav>
}
