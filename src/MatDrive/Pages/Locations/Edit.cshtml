@page "/locations/edit/{id:long}"
@model MatDrive.Pages.Locations.EditModel
@using MatDrive.Services.Locations
@{
    ViewData["Title"] = Model.Name;
    ViewData["Crumbs"] = Model.Crumbs;
    ViewData["Width"] = "wide";
    ViewData["PageSub"] = Model.Error is null && !Model.CanEdit ? L["Locations.Editor.ReadOnly"].Value : null;
}
@section Head {
    <link rel="stylesheet" href="~/css/locations.css" asp-append-version="true" />
}
@section TopActions {
    <a class="mat-btn mat-btn--secondary mat-btn--icon" href="@IndexModel.ContentUrl(Model.Id, Model.Display, download: true)" aria-label="@L["Locations.Download"]" data-tip="@L["Locations.Download"]">@Ui.Icon("download")</a>
}

@if (Model.Error is { } error)
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body"><strong>@L["Locations.Editor.CannotOpen"]</strong><p>@error</p></div></div>
    <div class="mat-btn-row">
        <a class="mat-btn mat-btn--secondary" href="@Model.FolderUrl">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
    </div>
}
else
{
    <div class="md-editor md-loc-editor" id="md-loc-editor" data-location="@Model.Id" data-path="@Model.Display" data-etag="@Model.ETag" data-can-edit="@(Model.CanEdit ? "true" : "false")" data-back="@Model.FolderUrl">
        <label class="mat-sr-only" for="md-loc-text">@L["Locations.Editor.Label", Model.Name]</label>
        <textarea class="md-editor__area" id="md-loc-text" spellcheck="false" autocomplete="off" wrap="off" readonly="@(!Model.CanEdit)">
@Model.Text</textarea>
        <div class="mat-btn-row md-loc-editor__foot">
            @if (Model.CanEdit)
            {
                <button type="button" class="mat-btn mat-btn--primary" data-editor-save>@Ui.Icon("save")<span>@L["Common.Save"]</span></button>
            }
            <a class="mat-btn mat-btn--secondary" href="@Model.FolderUrl" data-editor-back>@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
            <span class="mat-btn-row__spacer"></span>
            <span class="md-editor__state" data-editor-state aria-live="polite"></span>
        </div>
    </div>
}

@section Scripts {
    <script type="module" src="~/js/locations.js" asp-append-version="true"></script>
}
