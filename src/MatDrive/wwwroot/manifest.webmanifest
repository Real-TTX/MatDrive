{
  "id": "/",
  "name": "MatDrive",
  "short_name": "MatDrive",
  "description": "Your files in the browser: drives, sharing, versions, WebDAV. Deine Dateien im Browser: Ablagen, Teilen, Versionen, WebDAV.",
  "start_url": "/drive",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f5f4f1",
  "theme_color": "#8e24aa",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "My Drive / Meine Ablage",
      "short_name": "Drive",
      "url": "/drive",
      "icons": [
        {
          "src": "/img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Shared with me / Für mich freigegeben",
      "short_name": "Shared",
      "url": "/drive/shared",
      "icons": [
        {
          "src": "/img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Recent / Zuletzt",
      "short_name": "Recent",
      "url": "/drive/recent",
      "icons": [
        {
          "src": "/img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Upload / Hochladen",
      "short_name": "Upload",
      "url": "/drive?new=files",
      "icons": [
        {
          "src": "/img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
