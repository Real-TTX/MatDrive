@page "/Admin/Integrations"
@model MatDrive.Pages.Admin.IntegrationsModel
@{
    ViewData["Title"] = L["Integrations.Title"].Value;
    ViewData["PageSub"] = L["Integrations.Sub"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Admin.Title"].Value, null), (L["Integrations.Title"].Value, null) };
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("kind-docs")MatOffice</h2></div>
                <div class="mat-card__body mat-form">
                    <md-field name="Enabled" kind="switch" label="@L["Office.Enabled"]" value="@Model.Enabled.ToString()" hint="@L["Office.Enabled.Hint"]" />
                    <md-field name="OfficeUrl" kind="url" label="@L["Office.Url"]" value="@Model.OfficeUrl" placeholder="https://office.example.com" hint="@L["Office.Url.Hint"]" show-if="Enabled" show-value="true" />
                    <md-field name="Key" kind="password" label="@L[Model.HasKey ? "Office.Key.New" : "Office.Key"]" autocomplete="off" optional="@Model.HasKey" hint="@L[Model.HasKey ? "Office.Key.HintSet" : "Office.Key.Hint"]" show-if="Enabled" show-value="true" />
                    <md-field name="InternalUrl" kind="url" label="@L["Office.InternalUrl"]" value="@Model.InternalUrl" placeholder="http://host.docker.internal:4820" optional hint="@L["Office.InternalUrl.Hint"]" show-if="Enabled" show-value="true" />
                    <md-field name="DriveUrl" kind="url" label="@L["Office.DriveUrl"]" value="@Model.DriveUrl" placeholder="http://host.docker.internal:4810" optional hint="@L["Office.DriveUrl.Hint", Model.Origin]" show-if="Enabled" show-value="true" />
                </div>
            </div>
            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>@L["Common.Save"]</span></button>
                <a class="mat-btn mat-btn--secondary" href="/drive">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
                @if (Model.Enabled && Model.HasKey)
                {
                    <button type="submit" class="mat-btn mat-btn--secondary" formaction="@Url.Page("Integrations", "Check")" formnovalidate>@Ui.Icon("refresh")<span>@L["Office.Check"]</span></button>
                }
            </div>
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("info")@L["Office.Formats"]</h2></div>
            <div class="mat-card__body">
                @if (Model.Kinds.Count == 0)
                {
                    <p class="md-muted">@L["Office.Formats.None"]</p>
                }
                else
                {
                    <dl class="mat-kv">
                        @foreach (var k in Model.Kinds)
                        {
                            <dt><span class="md-name"><svg class="mat-icon" data-colour="@k.Colour" aria-hidden="true" focusable="false"><use href="#mat-i-kind-@k.Kind"></use></svg><span>@k.Name</span></span></dt>
                            <dd class="mat-mono">@string.Join(", ", k.Formats.Where(f => f.Open).Select(f => f.Write ? f.Ext : f.Ext + " (" + L["Office.ReadOnly"].Value + ")"))</dd>
                        }
                    </dl>
                    @if (Model.CheckedDate is { } c)
                    {
                        <p class="mat-hint">@L["Office.CheckedOn", Dates.Stamp(c, Model.Zone)]</p>
                    }
                }
                <p class="md-muted">@L["Office.HowTo"]</p>
            </div>
        </div>
    </div>
</div>
