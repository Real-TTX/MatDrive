@page "/Account/AppPasswords"
@model MatDrive.Pages.Account.AppPasswordsModel
@{
    ViewData["Title"] = L["AppPasswords.Title"].Value;
    ViewData["PageSub"] = L["AppPasswords.Sub"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Settings.Title"].Value, "/Account"), (L["AppPasswords.Title"].Value, null) };
}

@if (Model.NewPassword is not null)
{
    <div class="mat-alert mat-alert--success md-mb" role="status">
        @Ui.Icon("key")
        <div>
            <strong>@L["AppPasswords.Once"]</strong>
            <div class="md-copyrow">
                <input class="mat-input mat-mono" id="app-password" type="text" readonly value="@Model.NewPassword" aria-label="@L["AppPasswords.Password"]" />
                <button type="button" class="mat-btn mat-btn--secondary" data-copy="#app-password">@Ui.Icon("copy")<span>@L["Common.Copy"]</span></button>
            </div>
        </div>
    </div>
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <div class="mat-list">
            @if (Model.Items.Count == 0)
            {
                <partial name="_Empty" model="@(new EmptyStateModel("key", L["AppPasswords.Empty"].Value, L["AppPasswords.EmptyText"].Value, true))" />
            }
            else
            {
                <md-table caption="@L["AppPasswords.Title"]">
                    <thead><tr><th scope="col">@L["Common.Name"]</th><th scope="col" class="mat-hide-sm">@L["AppPasswords.Starts"]</th><th scope="col">@L["AppPasswords.LastUsed"]</th><th scope="col"><span class="mat-sr-only">@L["Common.Actions"]</span></th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Items)
                        {
                            <tr>
                                <td data-label="@L["Common.Name"]">@p.Name<small class="md-muted md-block-line">@Dates.Stamp(p.CreateDate, Model.Zone)</small></td>
                                <td data-label="@L["AppPasswords.Starts"]" class="mat-mono mat-hide-sm">@(p.Prefix)…</td>
                                <td data-label="@L["AppPasswords.LastUsed"]" class="mat-mono">@(p.LastUsedDate is null ? L["Common.Never"].Value : Dates.Stamp(p.LastUsedDate, Model.Zone))</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id">
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm md-danger" aria-label="@L["AppPasswords.RevokeNamed", p.Name]" data-tip="@L["AppPasswords.Revoke"]"
                                                    data-confirm="@L["AppPasswords.RevokeConfirm", p.Name]" data-confirm-ok="@L["AppPasswords.Revoke"]">@Ui.Icon("trash")</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </md-table>
            }

            <form class="mat-form md-mt" method="post" novalidate>
                <partial name="_FormSummary" model="ViewData.ModelState" />
                <md-field name="Name" label="@L["AppPasswords.NewName"]" value="@Model.Name" maxlength="80" required placeholder="@L["AppPasswords.NewName.Placeholder"]" msg-required="@L["Common.NameRequired"]" />
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>@L["AppPasswords.Create"]</span></button>
                </div>
            </form>
        </div>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("network")@L["AppPasswords.Connect"]</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>@L["AppPasswords.Address"]</dt><dd class="mat-mono">@Model.DavAddress</dd>
                    <dt>@L["AppPasswords.User"]</dt><dd class="mat-mono">@Model.Email</dd>
                </dl>
                <p class="md-muted">@L["AppPasswords.Connect.Windows"]</p>
                <p class="md-muted">@L["AppPasswords.Connect.Mac"]</p>
                <p class="md-muted">@L["AppPasswords.Connect.Linux"]</p>
            </div>
        </div>
    </div>
</div>
