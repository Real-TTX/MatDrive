@page "/drive/item/{id:long}/activity"
@model MatDrive.Pages.Drive.Item.ActivityModel
@{
    ViewData["Tab"] = "activity";
    ViewData["PageSub"] = L["Activity.Item.Sub"].Value;
}

<partial name="_ItemTabs" model="Model" />

<div class="mat-list">
    @if (Model.Items.Count == 0)
    {
        <partial name="_Empty" model="@(new EmptyStateModel("activity", L["Activity.Empty"].Value, L["Activity.EmptyText"].Value, true))" />
    }
    else
    {
        <md-table caption="@L["Item.Tab.Activity"]">
            <thead><tr><th scope="col">@L["Activity.Col.Date"]</th><th scope="col">@L["Activity.Col.What"]</th><th scope="col" class="mat-hide-sm">@L["Activity.Col.Item"]</th><th scope="col">@L["Activity.Col.Who"]</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Items)
                {
                    <tr>
                        <td data-label="@L["Activity.Col.Date"]" class="mat-mono">@Dates.Stamp(a.Date, Model.Zone)</td>
                        <td data-label="@L["Activity.Col.What"]">@L["Activity.Action." + a.Action]@if (!string.IsNullOrEmpty(a.Detail)) { <small class="md-muted md-block-line">@a.Detail</small> }</td>
                        <td data-label="@L["Activity.Col.Item"]" class="mat-hide-sm">@a.Target</td>
                        <td data-label="@L["Activity.Col.Who"]">@(a.UserName ?? L["Activity.Someone"].Value)</td>
                    </tr>
                }
            </tbody>
        </md-table>
    }
    <div class="mat-actions">
        <a class="mat-btn mat-btn--secondary" href="@Model.FolderUrl">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
    </div>
</div>
