@page "/Admin/Locations"
@model MatDrive.Pages.Admin.Locations.IndexModel
@using MatDrive.Services.Locations
@{
    ViewData["Title"] = L["Locations.Title"].Value;
    ViewData["PageSub"] = L["Locations.Admin.Sub", Model.StorageRoot].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Admin.Title"].Value, null), (L["Locations.Title"].Value, null) };
}
@section Head {
    <link rel="stylesheet" href="~/css/locations.css" asp-append-version="true" />
}

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Items.Count == 0)
    {
        var first = Model.Toolbar.Total == 0;
        <partial name="_Empty" model="@(new EmptyStateModel("server", L[first ? "Locations.Admin.Empty" : "Locations.Admin.NoMatch"].Value, L[first ? "Locations.Admin.EmptyText" : "Lists.ChangeTools"].Value, first, "/Admin/Locations/Edit", L["Locations.New"].Value, Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <md-table caption="@L["Locations.Title"]">
            <thead>
                <tr>
                    <th scope="col">@L["Common.Name"]</th>
                    <th scope="col">@L["Locations.Col.Kind"]</th>
                    <th scope="col" class="mat-hide-md">@L["Locations.Col.Where"]</th>
                    <th scope="col">@L["Common.Status"]</th>
                    <th scope="col" class="mat-num mat-hide-sm">@L["Locations.Col.Free"]</th>
                    <th scope="col"><span class="mat-sr-only">@L["Common.Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Items)
                {
                    var space = l.Status?.Space;
                    <tr>
                        <td data-label="@L["Common.Name"]">
                            <div class="md-loc-cell">
                                <a href="/Admin/Locations/Edit?id=@l.Id">@l.Name</a>
                                <small class="md-muted">@(l.ForEveryone ? L["Locations.ForEveryoneShort"].Value : L["Locations.PeopleCount", l.People].Value)@(l.IsReadOnly ? " · " + L["Locations.ReadOnly"].Value : string.Empty)</small>
                            </div>
                        </td>
                        <td data-label="@L["Locations.Col.Kind"]"><span class="md-loc-kind">@Ui.Icon(l.Kind == LocationKind.Local ? "server" : "network")<span>@LocationService.KindName(l.Kind)</span></span></td>
                        <td data-label="@L["Locations.Col.Where"]" class="mat-mono mat-hide-md md-loc-where">@l.Where</td>
                        <td data-label="@L["Common.Status"]">
                            @if (!l.IsActive)
                            {
                                <span class="mat-pill mat-pill--plain">@L["Locations.Inactive"]</span>
                            }
                            else if (l.Status is null)
                            {
                                <span class="mat-pill mat-pill--plain">@L["Locations.NotChecked"]</span>
                            }
                            else if (l.Status.Reachable)
                            {
                                <span class="mat-pill mat-pill--ok" title="@L["Locations.CheckedAt", Dates.Stamp(l.Status.CheckedUtc, Model.Zone)]">@L["Locations.Reachable"]</span>
                            }
                            else
                            {
                                <span class="mat-pill mat-pill--error" title="@l.Status.Message">@L["Locations.Unreachable"]</span>
                            }
                        </td>
                        <td data-label="@L["Locations.Col.Free"]" class="mat-num mat-mono mat-hide-sm">
                            @if (space is not null && l.IsActive)
                            {
                                <span title="@L["Locations.SpaceFree", Ui.Bytes(space.Free), Ui.Bytes(space.Total)]">@Ui.Bytes(space.Free)</span>
                            }
                            else
                            {
                                <span class="md-muted">–</span>
                            }
                        </td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Admin/Locations/Access?id=@l.Id" aria-label="@L["Locations.AccessNamed", l.Name]" data-tip="@L["Locations.Tab.Access"]">@Ui.Icon("users")</a>
                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Admin/Locations/Edit?id=@l.Id" aria-label="@L["Common.EditNamed", l.Name]" data-tip="@L["Common.Edit"]">@Ui.Icon("edit")</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </md-table>
    }

    <partial name="_Pager" model="Model.Pager" />

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Admin/Locations/Edit">@Ui.Icon("plus")<span>@L["Locations.New"]</span></a>
        @if (Model.Toolbar.Total > 0)
        {
            <form method="post" asp-page-handler="Check" class="md-loc-inline">
                <button type="submit" class="mat-btn mat-btn--secondary">@Ui.Icon("refresh")<span>@L["Locations.CheckAll"]</span></button>
            </form>
        }
    </div>
</div>
